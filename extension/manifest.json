{
  "manifest_version": 3,
  "name": "Auctra Procurement Copilot",
  "version": "1.0.0",
  "description": "Enterprise Procurement Copilot for IndiaMART, Amazon Business, Alibaba, and TradeIndia.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.indiamart.com/*",
    "https://*.amazon.in/*",
    "https://*.amazon.com/*",
    "https://*.alibaba.com/*",
    "https://*.tradeindia.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auctra Procurement Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.indiamart.com/*",
        "https://*.amazon.in/*",
        "https://*.amazon.com/*",
        "https://*.alibaba.com/*",
        "https://*.tradeindia.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
